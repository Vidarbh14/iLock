# ==============================================================================
# iLock Environment Configuration
# ==============================================================================
# IMPORTANT:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# - DO NOT expose service-role keys or secrets to the browser.
# - Copy this file to .env.local in apps/web and configure your environment.
# ==============================================================================

# --- SUPABASE PUBLIC CONFIGURATION (Safe for Client / Browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# --- SUPABASE SERVER PRIVILEGED CONFIGURATION (Server-Side ONLY) ---
# DANGER: NEVER prefix with NEXT_PUBLIC_! Used only by secure server API routes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# --- SYSTEM & SECURITY SETTINGS ---
# Base URL for the web application (used for CORS and redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode: Set to "true" to allow simulated PC access testing without physical Windows service
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# Agent Heartbeat & Timeout Tolerances (in seconds)
DEVICE_OFFLINE_THRESHOLD_SECONDS=90
HEARTBEAT_INTERVAL_SECONDS=30

# Rate Limiting Configuration
RATE_LIMIT_PAIRING_REQUESTS_PER_MINUTE=5
RATE_LIMIT_COMMANDS_PER_MINUTE=20
